<Window x:Class="PerfWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerfWidget" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12" Foreground="#E8EBF0">
  <Window.Resources>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#7C8596"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Foreground" Value="#E8EBF0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" CornerRadius="10" Background="#FF101318" BorderBrush="#2EFFFFFF"
          BorderThickness="1" Padding="16,12,16,14">
    <StackPanel>
      <!-- verdict -->
      <Grid x:Name="HeaderGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Top" Margin="0,6,10,0" Fill="#3DD68C"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="Headline" TextWrapping="Wrap" FontSize="14.5" FontWeight="SemiBold" Text="Measuring…"/>
          <TextBlock x:Name="HeadDetail" TextWrapping="Wrap" FontSize="11.5" Foreground="#9AA3B2" Margin="0,1,0,0"/>
          <StackPanel x:Name="IssuePanel" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,-6,0">
          <Button x:Name="CompactBtn" Style="{StaticResource ChromeBtn}" Content="&#xE70E;" ToolTip="Compact / full view"/>
          <Button x:Name="HideBtn" Style="{StaticResource ChromeBtn}" Content="&#xE921;" ToolTip="Hide to tray (click the tray icon to bring it back)"/>
        </StackPanel>
      </Grid>

      <!-- resources -->
      <StackPanel x:Name="ResourcePanel" Background="Transparent" Margin="0,12,0,0"/>

      <!-- apps -->
      <StackPanel x:Name="FullPanel" Margin="0,14,0,0">
        <Grid Margin="0,0,0,4">
          <TextBlock Text="TOP APPS" FontSize="10" FontWeight="SemiBold" Foreground="#7C8596"/>
          <TextBlock x:Name="SortLabel" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold"
                     Foreground="#B4BCC8" Cursor="Hand" Text="RAM · auto ▾"
                     ToolTip="Click to change what apps are ranked by. Auto follows whatever is under pressure right now."/>
        </Grid>
        <StackPanel x:Name="AppList"/>
        <TextBlock x:Name="DriveText" FontSize="10.5" Foreground="#7C8596" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
